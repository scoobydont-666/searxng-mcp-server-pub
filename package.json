{
  "name": "searxng-mcp-server",
  "version": "0.2.0",
  "description": "Authenticated SearXNG search via MCP and an optional JSON API with shared admission controls.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "express": "4.22.3",
    "jsdom": "25.0.1",
    "pdf-parse": "1.1.1",
    "prom-client": "15.1.3",
    "redis": "5.8.3",
    "turndown": "7.2.0",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.15",
    "@types/turndown": "5.0.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
